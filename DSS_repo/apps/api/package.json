{
  "name": "@dss/api", "private": true, "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "db:init": "npm run build && node dist/database/init.js",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11", "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11", "@fastify/cors": "^11.0.0",
    "class-transformer": "^0.5.1", "class-validator": "^0.14.2",
    "csv-parse": "^6.1.0", "dotenv": "^16.4.7", "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.1"
  },
  "devDependencies": {"@types/node": "^22.0.0", "typescript": "^5.7.3"}
}
